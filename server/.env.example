# Load these privately through your process manager. The server does not read
# .env files itself. Never bundle the enrollment secret in EXPO_PUBLIC_*.
CLEARPATH_PUBLIC_URL=http://127.0.0.1:8787
CLEARPATH_ENROLLMENT_SECRET=replace-with-at-least-32-random-characters
NWS_USER_AGENT=ClearPath/1.0 (replace-with-real-operator-contact@example.com)
PORT=8787
HOST=127.0.0.1
CLEARPATH_POLL_SECONDS=60
# For an explicitly trusted TLS reverse proxy on this machine only:
# CLEARPATH_PUBLIC_URL=https://your-watcher.example
# CLEARPATH_TRUST_LOOPBACK_PROXY=1
# EXPO_ACCESS_TOKEN=private-token-if-enhanced-Expo-push-security-is-enabled
