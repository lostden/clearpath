# Optional for native Google Maps builds. Expo Go uses its bundled map configuration.
# Restrict each public SDK key to its platform, app identifier, and required Maps SDK.
# Native SDK keys are bundled public credentials, never server-side secrets.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=

# Optional cloud-push pilot. Leave OFF until FCM, private HTTPS hosting and consent are ready.
# Public server origin only; never put an enrollment/device/server secret in EXPO_PUBLIC_*.
EXPO_PUBLIC_CLEARPATH_PUSH_URL=
CLEARPATH_PUSH_ENABLED=false
CLEARPATH_BACKGROUND_GPS=false
# Local ignored Firebase Android config path, or an EAS file-environment variable.
GOOGLE_SERVICES_JSON=
