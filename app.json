{
  "expo": {
    "name": "ClearPath",
    "slug": "clearpath",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "clearpath",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "icon": "./assets/brand/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/brand/adaptive.png",
        "monochromeImage": "./assets/brand/monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/brand/splash.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "93c6f679-06ad-4edf-8ff7-8eec0290035b"
      }
    },
    "owner": "lostdens-team"
  }
}
