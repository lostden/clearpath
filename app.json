{
  "expo": {
    "name": "ClearPath",
    "slug": "clearpath",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "clearpath",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/brand/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#173C57",
        "foregroundImage": "./assets/brand/adaptive.png",
        "monochromeImage": "./assets/brand/monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#173C57",
          "image": "./assets/brand/splash.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
